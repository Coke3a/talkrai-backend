# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
REQUEST_TIMEOUT_SECS=30
BODY_LIMIT_BYTES=1048576

# Database
DATABASE_URL=postgres://user:password@localhost:5432/talk_a_line
DB_MAX_CONNECTIONS=10

# LINE
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
RICH_MENU_NO_SESSION=richmenu-xxx-state-a
RICH_MENU_ACTIVE_SESSION=richmenu-xxx-state-b
NARRATOR_AVATAR_URL=https://example.com/narrator-avatar.png
NARRATOR_DISPLAY_NAME=from RP
LIFF_BASE_URL=https://liff.line.me/your-liff-id

# AI — LLM Provider Configuration
CLAUDE_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
VENICE_API_KEY=xxx
DEFAULT_LLM_PROVIDER=claude
AI_MAX_TOKENS=1024

# Background Tasks
JOB_CHANNEL_CAPACITY=100
MAX_CONCURRENT_JOBS=10
POLL_INTERVAL_SECS=5
POLL_BATCH_SIZE=10
CLEANUP_INTERVAL_SECS=60
STALE_THRESHOLD_SECS=120

# Application
WELCOME_CREDITS=50

# Logging
RUST_LOG=info
