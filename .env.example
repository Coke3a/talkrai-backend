# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
REQUEST_TIMEOUT_SECS=30
BODY_LIMIT_BYTES=1048576
ENABLE_SWAGGER=true

# Database
DATABASE_URL=postgres://user:password@localhost:5432/talk_a_line
DB_MAX_CONNECTIONS=10

# LINE
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_ID=your_line_channel_id
LIFF_BASE_URL=https://liff.line.me/your-liff-id
CORS_ORIGIN=https://your-frontend-domain.com
RICH_MENU_0_ID=richmenu-xxx
RICH_MENU_A_ID=richmenu-xxx
RICH_MENU_B_ID=richmenu-xxx

# AI — LLM Provider Configuration
CLAUDE_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
VENICE_API_KEY=xxx
TOGETHER_API_KEY=xxx
DEFAULT_LLM_PROVIDER=claude

# Beam Payment
BEAM_MERCHANT_ID=your-merchant-id
BEAM_API_KEY=your-api-key
BEAM_HMAC_KEY=your-base64-hmac-key

# Background Tasks
JOB_CHANNEL_CAPACITY=100
MAX_CONCURRENT_JOBS=10
POLL_INTERVAL_SECS=5
POLL_BATCH_SIZE=10
CLEANUP_INTERVAL_SECS=60
STALE_THRESHOLD_SECS=120

# Internal API (shared secret for the daily re-engagement cron; unset disables /internal/*)
INTERNAL_API_TOKEN=

# Logging
RUST_LOG=info

# Dev Auth Bypass (localhost testing only — MUST be false in production)
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_TEST_LINE_USER_ID=
DEV_AUTH_TEST_TOKEN=dev-token
